Try this out:
- ctrl+f7 toggles the status bar
- ctrl+alt+c compiles the code
- f5 runs the code
- set a breakpoint with mouse on left or f9 at the cursor
- When the lower-left pane is selected, the asm index of the currently
highlighted asm instruction will be shown in the status bar.
- Press ctrl+shift+g to move between a code line and its corresponding asm instruction.
- ctrl+alt+o toggles text op messages in debug mode.
- ctrl+alt+i toggles disassembly in debug mode.
main :: () {
	#asm {
		//The jmp instructions allows you to jump to a specific instruction by asm index.
		jmp 2;
		mov ax, 1;
		//This will jmp to asm index 4 if the second operand is not 0.
		tjmp 4, 1; 
		mov ax, 2; 
		//This will jmp to asm index 6 if the second operand is 0.
		fjmp 6, 0; 
		mov ax, 3; 
		mov bx, 1;
		//This will jmp to "label" if the second operand is not 0.
		tjmp label, bx;
		add cx, ax, bx;
		mov bx, 3;

		//A label in assembly is a word followed by ":"
		label: mov bx, 5;
		add bx, ax;
	}

	//An if statement is an fjmp.
	if 1 {

	}
	//An if-else is an fjmp and a jmp.
	if 0 {

	} //The jmp is here to skip over the else.
	else {

	}

	//An if - else if statement is a sequence of fjmps and jmps.
	if 0 {

	} //The jmp is here to skip over the other else-ifs.
	else if 0 {

	} 
	else if 0 {

	} 
	else {

	}

	/*To learn about operators
	load_op operators guides/programming/operators
	*/

	//Any logical condition can be checked with an if statement.
	if 0 == 1 {

	} 
	else if 0 == 0 {

	}

	//An if statement can be replaced with a while loop.
	//A while loop is an fjmp followed by a jmp that goes back to the while loop.
	while 0 {

	} //The jmp is here that goes back to the while loop.

	//Any conditional code statement runs the code in its curly brackets when the value is true(not 0).
	x : int;
	if 1 {
		x = 1;
	}

	if 0 {

	} 
	else {
		x = 2;
	}

	if 0 {
		x = 3;
	} 
	else if x == 1 {
		x = 4;
	}

	while x < 6 {
		x += 1;
	}
}