#load "c_load/Library";

/*Op rows can be used as rows in op spaces which refer to the music pts in the base rows.
Music points are mapped from the base rows onto the op rows and 
the dimensions and tuning systems of the op row can be changed.

"ctrl+q" toggles hover chord and hover note when mouse is on a row.

Alternative row hover audio and text
guides_dl/row_hover/row_hover_dl.jai

Op rows with a dl in
guides_dl/op_rows/op_rows_dl.jai
*/
main :: () {
	clear_m0 : AsmClearMSpaceData;
	clear_m0.mspace_id = 0;
	#asm{ clear_mspace clear_m0; }

	rs : [3] RowSectionData;
	rs[0].tuning_system_id = 13;
	rs[0].x_length = 4;
	rs[1].tuning_system_id = 0;
	rs[1].x_length = 4;
	rs[2].tuning_system_id = 1;
	rs[2].x_length = 4;
	rd : AsmCreateRowData;
	rd.octave_height = 12.0;
	rd.row_height = 12.0;
	rd.external_hover_row = false;
	rd.remove_row_hover_text = false;
	rd.mute_hover = false;
	rd.row_sections = rs;
	rd.row_system_type = RowSystemType.internal_pitch;
	//rd.row_system_type = RowSystemType.midi_pitch;
	//rd.row_midi_data.midi_port = 0;
	//rd.row_midi_data.midi_channel = 0;
	//rd.row_midi_data.midi_velocity = 100;
	//rd.row_midi_data.midi_zero_note = 12*4;
	// rd.row_system_id = synth.ret_synth_id;
	#asm{ create_row rd; }

	tano(0,0) ~= 3;
	tano(0,2) ~= int.[0,4];
	tano(0,3) ~= int.[2,7];
	tano(0,6..8.5) ~= int.[8,10,12];

	csd : AsmOpSpaceData;
	csd.op_space_type = AsmOpSpaceType.space_2d;
	csd.op_space_name = "op_r";
	#asm{ get_or_create_op_space csd; }

	clear : AsmClearOpData;
	clear.op_space_id = csd.ret_op_space_id;
	#asm{ clear_op_space clear; }

	/*Multi-section op rows will refer to the op_ref_row_id
	and can start from op_ref_start_x and 
	have any tuning system sections via row_section_data.
	Dimensions of the op row can be changed.
	*/
	rs_2 : [2] RowSectionData;
	rs_2[0].tuning_system_id = 1;
	rs_2[0].x_length = 3;
	rs_2[1].tuning_system_id = 13;
	rs_2[1].x_length = 3;
	acord : AsmCreateOpRowData;
	acord.octave_height = 12.0;
	acord.row_height = 12.0;
	acord.row_section_data = rs_2;
	acord.mute_hover = false;
	acord.x_point_width = 1.5;
	acord.op_pos = Vector2.{2,3};
	acord.op_row_type = OpRowType.MULTI_SECTION;
	acord.op_ref_row_id = rd.ret_row_id;
	acord.op_ref_mspace_id = 0;
	acord.op_ref_start_x = 2;
	acord.op_space_id = csd.ret_op_space_id;
	#asm{ create_op_row acord; }

	/*Copy music rows will directly copy and entire base row in an op space.
	Dimensions of the op row can be changed.
	*/
	a2 : AsmCreateOpRowData;
	a2.octave_height = 12.0;
	a2.row_height = 10.0;
	a2.mute_hover = false;
	a2.x_point_width = 1.25;
	a2.op_pos = Vector2.{-10,-10};
	a2.op_row_type = OpRowType.COPY_MUSIC_ROW;
	a2.op_ref_row_id = rd.ret_row_id;
	a2.op_ref_mspace_id = 0;
	a2.op_space_id = csd.ret_op_space_id;
	#asm{ create_op_row a2; }
}