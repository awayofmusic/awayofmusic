#load "c_load/Library";
/*
Try this out:
- "ctrl+f7" toggles the text status bar
- "ctrl+alt+d" for debug mode.
- "ctrl+alt+c" to compile.
- "F5" to run the code.
- "WASD" can be used to move the 2d op space camera.
- See the #asm block for music asm notes
*/
main :: () {
	clear_m0 : AsmClearMSpaceData;
	#asm{ clear_mspace clear_m0; }

	synth : AsmGetOrCreateSimpleSynthData;
	synth.synth_name = "s0";
	#asm{ get_or_create_simple_synth synth; }
	update_synth : AsmUpdateSimpleSynthData;
	update_synth.synth_id = synth.ret_synth_id;
	update_synth.update_wave_type = true;
	update_synth.wave_type = OscWaveType.SINE;
	update_synth.update_volume = true;
	update_synth.volume = 0.1;
	#asm{ update_simple_synth update_synth; }

	ts : AsmGetTuningSystemData;
	ts.short_name = "et12";
	#asm{ get_tuning_system ts; };
	rs : RowSectionData;
	rs.tuning_system_id = ts.ret_tuning_system_id;
	rs.x_length = 24;
	rd : AsmCreateRowData;
	rd.octave_height = 12.0;
	rd.row_height = 12.0;
	rd.muted_row = false;
	rd.row_sections = RowSectionData.[rs];
	rd.row_system_type = RowSystemType.internal_pitch;
	rd.row_system_id = synth.ret_synth_id;
	// rd.row_system_type = RowSystemType.midi_pitch;
	// rd.row_midi_data.midi_channel = 0;
	// rd.row_midi_data.midi_velocity = 100;
	#asm{ create_row rd; }
	#asm{ create_row rd; }
	#asm{ create_row rd; }
	#asm{ create_row rd; }

	/*Music is made in assembly with "<row,x>"
	Row can be an int or int register.
	X can be an int, float or float register.

	Try setting a break point to see what each music instruction does.
	Breakpoint can be set with left mouse on left grey column or f9 at text cursor. 
	*/
	#asm {
		//Set value 0 with default length 1
		mov <0,0>, 0;
		//Set value 4 with length 2
		mov <0,1>, 4, 2;

		//Move values from row=0, x=0 to row=0, x=3
		mov <0,3>, <0,0>;
		//Move values from row=0, x=0 to row=1, x=0 for an x_range of 2
		mov <1,3>, <0,0>, 2;
		//Move values from row=0, x=0 to row=1, x=0 for a row_range of 1 and x_range of 2
		mov <2,0>, <0,0>, <1,2>;

		//All details for mov asm music in thegame_code.jai function ExecMov

		//Clear all values in this music space
		tclear;

		//Music arithmetic in assembly
		mov <0,0>, 0;
		//add 4 to all values in <0,0> and put at <0,1>
		add <0,1>, <0,0>, 4;
		//subtract all values in <0,1> from 12 and put at <0,2>
		sub <0,2>, 12, <0,1>;

		mov <0,0>, 4;
		//values that are the same at both <0,0> and <0,1> in <0,3>
		and <0,3>, <0,0>, <0,1>;
		or <0,4>, <0,1>, <0,2>;

		mov.f ax, 5.5;
		mov bx, 1;
		//If the x is a register then it must be a float
		//If row is a register then it must be an int
		mov <bx,ax>, 2;
		mov <1,5.5>, 5;
		//add 1 to all values
		add <bx,ax>, 1;
	}

	//All music asm instructions are in thegame_code.jai function ExecMInstr
	//or thegame_code.jai ASM_INSTRUCTION_MANUAL for the types
}