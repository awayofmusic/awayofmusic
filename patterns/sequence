#load "c_load/Library";

main :: () {
	clear_m0 : AsmClearMSpaceData;
	#asm{ clear_mspace clear_m0; }

	synth : AsmGetOrCreateSimpleSynthData;
	synth.synth_name = "s0";
	#asm{ get_or_create_simple_synth synth; }
	update_synth : AsmUpdateSimpleSynthData;
	update_synth.synth_id = synth.ret_synth_id;
	update_synth.update_wave_type = true;
	update_synth.wave_type = OscWaveType.SAW;
	update_synth.update_volume = true;
	update_synth.volume = 0.1;
	#asm{ update_simple_synth update_synth; }


	ts : AsmGetTuningSystemData;
	ts.short_name = "et12";
	#asm{ get_tuning_system ts; };
	rs : RowSectionData;
	rs.tuning_system_id = ts.ret_tuning_system_id;
	rs.x_length = 12;
	rd : AsmCreateRowData;
	rd.octave_height = 12.0;
	rd.row_height = 2. * rd.octave_height;
	rd.row_sections = RowSectionData.[rs];
	rd.row_system_type = RowSystemType.internal_pitch;
	rd.row_system_id = synth.ret_synth_id;
	#asm { create_row rd; }
	rd.row_base_pt = -23.;
	#asm { create_row rd; }
	
	//Sequence(0, 9, int.[+3,+3]);
	//Sequence(1, 0, int.[-3,-3]);

	//TODO Should we write a test for this or just write a test for this sequence file?
	x : int = 9;
	tano(0,0) ~= x;
	for int.[+3,+3,+3] {
		tano(0,it_index+1) ~= x+it;
		x += it;
	}

	x = 0;
	tano(1,0) ~= x;
	for int.[-3,-3,-3] {
		tano(1,it_index+1) ~= x+it;
		x += it;
	}
}

Sequence :: (row : int, start : int, seq : [] int) {
	tano(row,0) ~= start;
	mp : int = start;
	for 0..seq.count-1 {
		mp += seq[it];
		tano(row,it+1) ~= mp;
	}
}